    {
      "id": "rWjOfdBkNm6ayHLDaFEey",
      "type": "text",
      "x": 195.41015625,
      "y": -31.401885986328125,
      "width": 767.3995361328125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1167950781,
      "version": 458,
      "versionNonce": 1036882141,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780336177616,
      "link": null,
      "locked": false,
      "text": "R: READ -> GET -> Obtener información (Recursos)\nC: CREATE -> POST -> Te envío información para guardes el recurso\nU: UPDATE -> PUT y PATCH -> Te envío info para que modifiques un recurso \nD: DELETE -> DELETE -> Te envío identificador para borres el recurso",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "R: READ -> GET -> Obtener información (Recursos)\nC: CREATE -> POST -> Te envío información para guardes el recurso\nU: UPDATE -> PUT y PATCH -> Te envío info para que modifiques un recurso \nD: DELETE -> DELETE -> Te envío identificador para borres el recurso",
      "autoResize": true,
      "lineHeight": 1.25
    },
